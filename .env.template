# For local use. Run make secrets to create the configuration and generate credentials.
APP_HOST=127.0.0.1
APP_PORT=8003
LOG_LEVEL=INFO
LOG_SKIP_STATIC_ACCESS=true
API_DOCS_ENABLED=true
ADMIN_USERNAME=admin
WEB_SESSION_HTTPS_ONLY=false

# Paths inside the Stellar process/container. Configure SSH keys in SSH_CONFIG_FILE.
# SSH_CONFIG_FILE=/run/stellar-ssh/config
# SSH_KNOWN_HOSTS_FILE=/run/stellar-ssh/known_hosts

# Clear COMPOSE_PROFILES and set DB_HOST to use an external PostgreSQL server.
COMPOSE_PROFILES=local-storage
DB_USER=stellar
DB_NAME=stellar
